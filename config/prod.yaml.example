# Production configuration template for Fast Chat backend.
#
# Copy this file to prod.yaml (or any name) and fill in the values:
#   cp config/prod.yaml.example config/prod.yaml
#
# Then run the backend with:
#   cd backend && ./bin/fastchat --config=../config/prod.yaml
#
# SECURITY NOTES:
# - Replace all <PLACEHOLDER> values before deploying.
# - Keep prod.yaml out of version control (config/.gitignore already excludes it).
# - Use strong random values for any secrets.

server:
    # Public host the server binds to (0.0.0.0 to listen on all interfaces).
    host: 0.0.0.0
    port: 8080
    # Path to the built frontend assets (output of `make build:frontend`).
    static_dir: ../frontend/dist
    # Optional: list the reverse proxies in front of this server, so the client
    # IP can be recovered from X-Forwarded-For for rate limiting.
    #
    # Two rules. List proxy hops ONLY, never the address space of real clients:
    # a client connecting from a listed range is skipped as if it were a proxy
    # and a forged address becomes its rate limit key. And the proxy must
    # OVERWRITE X-Real-IP (nginx: `proxy_set_header X-Real-IP $remote_addr`),
    # not forward the client's copy, or the limiter can be bypassed again.
    # trusted_proxies:
    #     - "10.0.0.0/8"

database:
    # SQLite database file path. Use an absolute path on production.
    path: /var/lib/fastchat/fastchat.db

uploads:
    # Directory for uploaded files. Must be writable by the server process.
    dir: /var/lib/fastchat/uploads

cors:
    # Comma-separated list of allowed origins for browser requests.
    # Must match the public URL of the frontend (no trailing slash).
    origin: https://chat.example.com

email:
    # Set to false in production to send real emails.
    debug_mode: false
    # Restrict registration to these email addresses (empty = allow all).
    allowed_emails: []
    smtp:
        host: smtp.example.com
        port: 587
        username: <SMTP_USERNAME>
        password: <SMTP_PASSWORD>
        from: noreply@example.com

federation:
    # http or https. Use https in production.
    scheme: https
    # Timeout in seconds for outbound federation requests.
    timeout: 10
    # Directory for federation signing keys.
    key_path: /var/lib/fastchat/federation

push:
    # VAPID subject for web push notifications (usually a mailto: link).
    vapid_subject: mailto:admin@example.com
    # Directory for VAPID push keys.
    key_path: /var/lib/fastchat/keys

auth:
    # JWT token lifetime.
    token_expiry: 24h
    # When to warn the client that the token is about to expire.
    token_expiry_warning: 5m

rate_limits:
    send_code:
        limit: 5
        window: 1m
    verify_code:
        limit: 10
        window: 1m
    register:
        limit: 5
        window: 10m
    general:
        limit: 600
        window: 1m
