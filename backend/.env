# Время в секундах, в течение которого доступно редактирование сообщения.
# 0  — всегда доступно
# <0 — всегда недоступно
MESSAGE_EDIT_TTL=300

# Время в секундах, в течение которого доступно удаление сообщения.
# 0  — всегда доступно
# <0 — всегда недоступно
MESSAGE_DELETE_TTL=0

# Домен сервера для федерации. Добавляется к нику при регистрации (nick:domain).
SERVER_DOMAIN=localhost:8080
