{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "dist",
		"rootDir": ".",
		"strict": true,
		"declaration": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"lib": [
			"ES2022",
			"DOM"
		],
		"types": [
			"node"
		],
		"typeRoots": [
			"../../frontend/node_modules/@types"
		]
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts",
		"examples/**/*.ts"
	]
}
