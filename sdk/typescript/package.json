{
	"name": "@fastchat/bot",
	"version": "0.1.0",
	"description": "TypeScript SDK for the Fast Chat Bot API",
	"type": "module",
	"main": "./dist/src/index.js",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js",
			"default": "./dist/src/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/src",
		"dist/examples"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "npm run build && node --test dist/test/*.test.js",
		"prepack": "npm run build"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"typescript": "^5.9.0",
		"@types/node": "^26.6.6"
	},
	"dependencies": {
		"libsodium-wrappers": "^0.8.0"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/i-panov/fast_chat.git",
		"directory": "sdk/typescript"
	},
	"publishConfig": {
		"access": "public"
	}
}
